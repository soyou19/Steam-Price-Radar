# EditorConfig — https://editorconfig.org
# 让不同编辑器保持一致的基础格式，避免无意义的空白/换行差异
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown 里行尾两个空格是有意义的换行，不要裁剪
trim_trailing_whitespace = false

# Windows 批处理必须是 CRLF + ANSI/ASCII，cmd.exe 对 LF 解析会出错
[*.bat]
end_of_line = crlf
charset = latin1

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2
