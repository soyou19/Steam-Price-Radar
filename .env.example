# ---------------------------------------------------------------------------
# Steam 限免聚合服务 - 配置示例
# 复制为 .env 或直接设置为环境变量（项目不依赖 dotenv，启动脚本可自行 source）
# ---------------------------------------------------------------------------

# 监听地址与端口
HOST=127.0.0.1
PORT=8787

# ---------------------------------------------------------------------------
# 网络代理 / 加速器（重要）
# ---------------------------------------------------------------------------
# 国内直连 Steam 商店经常不通（实测 UND_ERR_CONNECT_TIMEOUT，直连真实 IP:443 被阻断）。
# 使用 Watt Toolkit / Steam++ 等加速器时，它会在本机起一个 MITM 代理并写入系统代理设置，
# 但 Node 原生 fetch **既不读取系统代理，也不信任系统证书 store**，必须显式配置：
#   1) PROXY_URL 填加速器的本地代理地址（留空则自动读取 HTTPS_PROXY / HTTP_PROXY）
#   2) 用 `npm start` 启动（它带 --use-system-ca，用于信任加速器的自签证书）
# 填 none 可强制直连。
# 例：PROXY_URL=http://127.0.0.1:26561
#
# ⚠️ 这条路要求 Node >= 22.21.0：
#    --use-system-ca 是 v22.15.0 / v23.8.0 才引入，--use-env-proxy 是 v22.21.0 才引入。
#    Node 20.x 两个都没有，配了代理也只会一直超时或报证书错误（启动器会打印 WARNING）。
PROXY_URL=

# 商店区域与语言（影响币种与标题语言）
# cc=cn + l=schinese 可获得人民币价格与中文标题
STEAM_CC=cn
STEAM_LANG=schinese

# 每个 Steam 域名的请求最小间隔（毫秒）。Steam 会限流，不要调得太低。
STEAM_MIN_INTERVAL_MS=900

# 搜索页请求的重试次数与单次超时（毫秒）
# 实测 Steam 偶发连接超时约 10s 才失败，多试几次比丢页更划算
STEAM_SEARCH_RETRIES=5
STEAM_SEARCH_TIMEOUT_MS=15000

# appdetails 校验请求的最小间隔（毫秒），该接口每请求只能查询 1 个 appid
DETAILS_MIN_INTERVAL_MS=450

# ---------------------------------------------------------------------------
# 轮询间隔（毫秒）
# ---------------------------------------------------------------------------
# 免费游戏候选集扫描一轮后，两轮之间的等待时间
SWEEP_INTERVAL_MS=120000
# 每轮候选集扫描抓取的页数（每页 100 条）
SWEEP_PAGES_PER_CYCLE=8
# 折扣清单（specials=1 全量，实测约 1.57 万条）每轮扫描页数，每页 100 条
DISCOUNTS_PAGES_PER_CYCLE=8
# 折扣清单两轮扫描之间的等待时间
DISCOUNTS_INTERVAL_MS=120000
# 折扣清单完整扫一轮后，间隔多久重新扫（发现新上架的促销）
DISCOUNTS_SWEEP_MS=21600000
# 关注清单（appid 精确校验）的轮询间隔
# 这是"发现限免 / 确认限免结束"的响应速度上限：调快 => 更实时，但请求更多
WATCHLIST_INTERVAL_MS=60000
# 每轮校验的 appid 数量上限（450ms/次，80 条约 36 秒）
WATCHLIST_BATCH=80
# 永久免费游戏的复核周期（毫秒）。默认 0 = **不复核**：
# 一旦确认是永久免费就基本不会再变，读一次即可（数据治理）。设成正数会显著增加请求量。
F2P_RECHECK_MS=0
# 折扣的复核周期：折扣会到期，需要定期确认是否还在打折
DISCOUNT_RECHECK_MS=21600000
# 商店精选位（免费周末等限时活动）轮询间隔
# 免费周末是订阅制限时体验，不会进入免费候选集，只能从精选位发现，所以单独跑
SPOTLIGHT_INTERVAL_MS=300000
# 启动时回填评测数据（评价数量 / 好评率 / 评价等级）的页数上限
# Steam 只在免费候选集的前段返回评测 tooltip，实测 start=12000 还有 99/100，start=20000 只剩 3/100
REVIEW_BACKFILL_PAGES=140
# 第三方限免聚合源（GamerPower）轮询间隔
GAMERPOWER_INTERVAL_MS=600000

# ---------------------------------------------------------------------------
# 行为开关
# ---------------------------------------------------------------------------
# 是否启用 Steam 免费候选集扫描
ENABLE_STEAM_SPECIALS=true
# 是否启用关注清单 appid 精确校验
ENABLE_STEAM_WATCHLIST=true
# 是否启用商店精选位（免费周末等限时活动）—— 免费周末只能从这里发现
ENABLE_STEAM_SPOTLIGHT=true
# 是否启用折扣清单扫描（specials=1，用于"高折扣参考"）
ENABLE_STEAM_DISCOUNTS=true
# 是否启用 GamerPower 第三方源
ENABLE_GAMERPOWER=true

# 关注清单：逗号分隔的 appid，会以较高频率精确轮询价格
# 例：WATCHLIST_APPIDS=730,570,413150
WATCHLIST_APPIDS=

# 疑似限时免费的 appid 自动加入高频关注清单的数量上限（0 表示关闭）
WATCHLIST_MAX=400


# 新发现事件推送到的 Webhook（Discord / Slack / 自定义 JSON POST），留空则关闭
WEBHOOK_URL=

# 数据落盘目录
DATA_DIR=.data

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
