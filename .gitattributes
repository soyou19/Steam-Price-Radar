# Git 属性 — 规范换行与文本判定，避免跨平台协作时文件被整体改写
# https://git-scm.com/docs/gitattributes

# 默认：交给 git 自动判定文本文件，仓库内存 LF
* text=auto eol=lf

# Windows 批处理必须保持 CRLF，否则 cmd.exe 解析出错
*.bat text eol=crlf

# PowerShell 脚本同样保持 CRLF
*.ps1 text eol=crlf

# 明确的文本类型（便于 diff 与语言统计）
*.js    text
*.mjs   text
*.json  text
*.md    text
*.css   text
*.html  text
*.yml   text
*.yaml  text

# 二进制
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary

# 运行期数据与日志不参与语言统计
.data/**   linguist-generated=true -diff
*.log      linguist-documentation=true -diff

# 让 GitHub 统计时不要把 bench 对照页当产品代码
bench/**   linguist-documentation=true
